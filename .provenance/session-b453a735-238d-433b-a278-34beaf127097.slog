{"data":{"content":"// The browser features behind data.gleam.\n\nimport { Result$Ok, Result$Error } from \"./gleam.mjs\";\n\n// localStorage can throw: when the browser blocks it for this site, or (on a\n// write) when the site is out of space.\nexport function storageGet(key) {\n  try {\n    const value = globalThis.localStorage.getItem(key);\n    return value === null ? Result$Error(undefined) : Result$Ok(value);\n  } catch {\n    return Result$Error(undefined);\n  }\n}\n\nexport function storageSet(key, value) {\n  try {\n    globalThis.localStorage.setItem(key, value);\n  } catch (error) {\n    console.error(`Couldn't save: ${error.message}`);\n  }\n}\n\n// Ask the user to name a new drawing; \"\" (empty string) means they cancelled.\nexport function promptDrawingName() {\n  const name = window.prompt(\"Name for the new drawing:\");\n  return name === null ? \"\" : name;\n}\n","line_count":29,"path":"src/data_ffi.mjs","sha256":"6cf5bd60cf99773738ad32a80d445602741fbe46ef69b262f51ed0670f43e6ab"},"hash":"af279420d237fb2d950b4681a152f64ed99cd63a202f8fd7f300baee84e849db","kind":"doc.open","prev_hash":"586ff9209a69e42158eb6fba3576f120b90040f2413a8828b908f7ff3480e106","seq":1,"t":2,"wall":"2026-11-23T23:37:29.508Z"}
