{"data":{"diff_size":159,"new_content":"//// The interpreter, which evaluates the program that the parser produces.\n\nimport errors.{type EvalError, MissingFunction, TypeError}\nimport gleam/dict.{type Dict}\nimport gleam/int\nimport gleam/list\nimport gleam/option.{type Option, None, Some}\nimport gleam/result\nimport gleam/string\nimport limits\nimport mutable_dict.{type MutableDict}\n\n// ── Types ─────────────────────────────────────────────────────────────────────\n\n/// The value of an expression evaluated in an environment.\npub type Value {\n  VBool(Bool)\n  VInt(Int)\n  VString(String)\n  VList(List(Value))\n  // A record (e.g., a Point or Line). The tag indicates its type.\n  VData(tag: String, fields: List(Value))\n  VFunc(Callable)\n}\n\n/// A record type has a constructor name and a list of field names.\npub type Constructor =\n  #(String, List(String))\n\n/// Rather than supporting new types, this interpreter uses a fixed set.\n/// Path's color field is optional at call sites (see builtins): omitted colour\n/// defaults to white when the Path value is built.\npub const constructors: List(Constructor) = [\n  #(\"Point\", [\"x\", \"y\"]),\n  #(\"Line\", [\"start\", \"end\"]),\n  #(\"Path\", [\"shape\", \"start\", \"end\", \"thickness\", \"color\"]),\n]\n\n/// The name-to-value bindings of a local frame (an immutable Gleam Dict).\npub type Bindings =\n  Dict(String, Value)\n\n/// The global frame is a mutable dictionary from names to values. It is mutable\n/// so that it can contain cycles: each top-level function in the global frame\n/// has the global frame as its env.\npub type GlobalFrame =\n  MutableDict(String, Value)\n\n/// An environment is a sequence of frames that includes a Local frame for each\n/// call to a user-defined function and a Global frame at the end.\npub type Env {\n  Local(bindings: Bindings, parent: Env)\n  Global(bindings: GlobalFrame)\n}\n\n/// A function value. A Builtin's run function implements its behavior, while a\n/// UserFn has a body Expr that is evaluated in a new frame whose parent is env.\npub type Callable {\n  Builtin(\n    name: String,\n    num_args: Int,\n    run: fn(List(Value)) -> Result(Value, EvalError),\n  )\n  UserFn(name: String, params: List(String), body: Expr, env: Env)\n}\n\n/// An Expr evaluates to a value when evaluated in an Env.\npub type Expr {\n  Var(String)\n  LiteralBool(Bool)\n  LiteralInt(Int)\n  // [a, b, ..rest] where the optional rest must evaluate to a list.\n  LiteralList(elems: List(Expr), rest: Option(Expr))\n  // f(x, y) where the fn_expr must evaluate to a function.\n  Call(fn_expr: Expr, operands: List(Expr))\n  // An anonymous function: fn(x, y) { ... }.\n  Lambda(params: List(String), body: Expr)\n  // A case expression: case subject { pattern -> expr }\n  Case(subject: Expr, arms: List(Arm))\n  // let name = value followed by body, the expression on the next line.\n  Let(name: String, value: Expr, body: Expr)\n  // Accessing a field value by name: p.x, line.start, etc.\n  FieldAccess(record: Expr, field: String)\n  // A source-line marker the parser adds around each let and each case arm so\n  // that error messages can include the line where an expression appeared.\n  At(line: Int, expr: Expr)\n}\n\n/// An arm of a case expression: a Pattern and the Expr evaluated if it matches.\npub type Arm =\n  #(Pattern, Expr)\n\n/// A pattern in a case expression.\npub type Pattern {\n  PBool(Bool)\n  PInt(Int)\n  PWildcard\n  PVar(String)\n  PList(elems: List(Pattern), rest: Option(String))\n}\n\n// ── Evaluation ────────────────────────────────────────────────────────────────\n\n/// Evaluate an expression in an environment.\nfn eval(expr: Expr, env: Env) -> Result(Value, EvalError) {\n  limits.charge(1)\n  case expr {\n    Var(name) -> lookup(env, name)\n    LiteralBool(b) -> Ok(VBool(b))\n    LiteralInt(n) -> Ok(VInt(n))\n    LiteralList(elems, rest) -> eval_list(elems, rest, env)\n    Call(fn_expr, operands) ->\n      // YOUR CODE HERE (replace the code below)\n      // calls evaled f on operands \n      // case list.try_map(operands, fn(e) { eval(e, env) }) {\n      //   // if every call returns Ok, call apply\n      //   Ok(v_list) ->\n      //     case eval(fn_expr, env) {\n      //       Ok(f) -> apply(f, v_list)\n      //       Error(e) -> Error(e)\n      //     }\n      //   Error(e) -> Error(e)\n      // }\n\n      case eval(fn_expr, env) {\n        Ok(f) ->\n          case list.try_map(operands, fn(e) { eval(e, env) }) {\n            Ok(v_list) -> apply(f, v_list)\n            Error(e) -> Error(e)\n          }\n        Error(e) -> Error(e)\n      }\n\n    // Evaluate the expression v exactly once, then extend env to include\n    // the name bound to its value; finally, evaluate the body of the let.\n    Let(name, v, body) ->\n      case eval(v, env) {\n        Error(e) -> Error(e)\n        // YOUR CODE HERE (replace the code below)\n        Ok(value) -> eval(body, extend(env, [#(name, value)]))\n      }\n    Case(subject, arms) ->\n      // YOUR CODE HERE (replace the code below)\n      case eval(subject, env) {\n        Ok(val) ->\n          case find_arm(val, arms) {\n            Ok(#(bindings, body)) -> eval(body, extend(env, bindings))\n            Error(Nil) -> Error(errors.NoMatchingCase)\n          }\n        Error(e) -> Error(e)\n      }\n    Lambda(params, body) ->\n      // YOUR CODE HERE (replace the code below)\n      Ok(VFunc(UserFn(\"lambda\", params, body, env)))\n    FieldAccess(record, field) ->\n      case eval(record, env) {\n        Error(e) -> Error(e)\n        Ok(v) -> get_field(v, field)\n      }\n    // An error from this expression is on this line.\n    At(line, expr) -> result.map_error(eval(expr, env), errors.at_line(_, line))\n  }\n}\n\n/// Evaluate a list literal [a, b, ..rest].\nfn eval_list(\n  elems: List(Expr),\n  rest: Option(Expr),\n  env: Env,\n) -> Result(Value, EvalError) {\n  case list.try_map(elems, fn(e) { eval(e, env) }), rest {\n    Error(e), _ -> Error(e)\n    // YOUR CODE HERE (replace the code below)\n    Ok(head), None -> Ok(VList(head))\n    Ok(head), Some(r) ->\n      case eval(r, env) {\n        // YOUR CODE HERE (replace the code below)\n        Ok(VList(tail)) -> Ok(VList(list.append(head, tail)))\n        Ok(other) -> Ok(VList([other]))\n        Error(e) -> Error(e)\n      }\n  }\n}\n\n/// Apply a function value to already-evaluated arguments. Every application costs\n/// one step, even of a built-in.\npub fn apply(f: Value, args: List(Value)) -> Result(Value, EvalError) {\n  limits.charge(1)\n  case f {\n    VFunc(callable) -> {\n      let wanted = num_params(callable)\n      case list.length(args) == wanted {\n        False -> Error(wrong_num_args(callable.name, wanted, list.length(args)))\n        True ->\n          case callable {\n            Builtin(_, _, run) ->\n              // YOUR CODE HERE (replace the code below)\n              run(args)\n            UserFn(_, params, body, parent) ->\n              // YOUR CODE HERE (replace the code below)\n              eval(body, Local(dict.from_list(list.zip(params, args)), parent))\n          }\n      }\n    }\n    _ -> Error(TypeError(\"calling a value that is not a function\"))\n  }\n}\n\n/// How many arguments a function takes.\nfn num_params(callable: Callable) -> Int {\n  case callable {\n    Builtin(_, num_args, _) -> num_args\n    UserFn(_, params, _, _) -> list.length(params)\n  }\n}\n\n/// The value of a record's field, found by its position in constructors.\nfn get_field(v: Value, field: String) -> Result(Value, EvalError) {\n  case v {\n    VData(tag, values) -> {\n      let names = result.unwrap(list.key_find(constructors, tag), [])\n      case list.key_find(list.zip(names, values), field) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> Error(TypeError(\"a \" <> tag <> \" has no .\" <> field))\n      }\n    }\n    _ ->\n      Error(TypeError(\".\" <> field <> \" expects a record, got \" <> describe(v)))\n  }\n}\n\n/// The value bound to name in env. A name is looked up exactly as in an\n/// environment diagram: check the current frame's bindings, then its\n/// parent's, and so on out to the Global frame. A name that no frame binds\n/// is an errors.UnboundVariable(name) error.\npub fn lookup(env: Env, name: String) -> Result(Value, EvalError) {\n  case env {\n    // Local(bindings, parent) ->\n    //   // YOUR CODE HERE (replace the code below)\n    //   Error(errors.NotImplemented(\n    //     \"lookup(\"\n    //     <> name\n    //     <> \") in Local(\"\n    //     <> string.inspect(dict.keys(bindings))\n    //     <> \", \"\n    //     <> string.inspect(parent)\n    //     <> \")\",\n    //   ))\n    Local(bindings, parent) ->\n      case dict.get(bindings, name) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> lookup(parent, name)\n      }\n    Global(bindings) ->\n      case mutable_dict.get(bindings, name) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> Error(errors.UnboundVariable(name))\n      }\n  }\n}\n\n// ── Pattern matching ──────────────────────────────────────────────────────────\n\n/// The bindings and body of the first arm whose pattern matches value, or\n/// Error(Nil) if no pattern matches.\npub fn find_arm(\n  value: Value,\n  arms: List(Arm),\n) -> Result(#(List(#(String, Value)), Expr), Nil) {\n  case arms {\n    [] -> Error(Nil)\n    [#(pattern, body), ..rest] ->\n      case match_pattern(pattern, value) {\n        Ok(bindings) -> Ok(#(bindings, body))\n        Error(Nil) -> find_arm(value, rest)\n      }\n  }\n}\n\n/// The names that pattern binds if it matches value, or Error(Nil) if it doesn't.\nfn match_pattern(\n  pattern: Pattern,\n  value: Value,\n) -> Result(List(#(String, Value)), Nil) {\n  case pattern, value {\n    PBool(b1), VBool(b2) if b1 == b2 -> Ok([])\n    PInt(n1), VInt(n2) if n1 == n2 -> Ok([])\n    PWildcard, _ -> Ok([])\n    // YOUR CODE HERE\n    PVar(name), _ -> Ok([#(name, value)])\n    PList(elems, rest), VList(vs) -> match_list(elems, rest, vs)\n    _, _ -> Error(Nil)\n  }\n}\n\n/// The names that the list pattern [elems, ..rest] binds if it matches the values\n/// vs, or Error(Nil) if it doesn't.\nfn match_list(\n  elems: List(Pattern),\n  rest: Option(String),\n  vs: List(Value),\n) -> Result(List(#(String, Value)), Nil) {\n  case elems, rest, vs {\n    [], None, [] -> Ok([])\n    // YOUR CODE HERE ( replace the code below)\n    // elems is empty, but there is a rest\n    [], Some(x), _ -> {\n      Ok([#(x, VList(vs))])\n    }\n    // YOUR CODE HERE\n    [a, ..elems_rest], _, [vs_elems, ..vs_rest] ->\n      case match_pattern(a, vs_elems), match_list(elems_rest, rest, vs_rest) {\n        Ok(elem_bindings), Ok(rest_bindings) ->\n          Ok(list.append(elem_bindings, rest_bindings))\n        _, _ -> Error(Nil)\n      }\n    _, _, _ -> Error(Nil)\n  }\n}\n\n// ── Running a program ─────────────────────────────────────────────────────────\n\n/// Call the function named function in the global frame on args.\npub fn run(\n  function: String,\n  args: List(Value),\n  global: GlobalFrame,\n) -> Result(Value, EvalError) {\n  use <- limits.guarded\n  // The function's body is evaluated here rather than through apply, so that\n  // a program runs even before apply can call user-defined functions.\n  case mutable_dict.get(global, function) {\n    Ok(VFunc(UserFn(_, params, body, env))) ->\n      case list.length(params) == list.length(args) {\n        True -> eval(body, Local(dict.from_list(list.zip(params, args)), env))\n        False -> Error(MissingFunction(function, list.length(args)))\n      }\n    _ -> Error(MissingFunction(function, list.length(args)))\n  }\n}\n\n// ── Helpers ──────────────────────────────────────────────────────────────────\n\n/// The environment with the `new` bindings added to the current frame, each\n/// replacing any earlier binding of the same name in that frame. A let and a\n/// case arm bind this way.\npub fn extend(env: Env, new: List(#(String, Value))) -> Env {\n  case env {\n    Local(existing, parent) ->\n      Local(dict.merge(existing, dict.from_list(new)), parent)\n    // Global is never extended\n    Global(_) -> env\n  }\n}\n\n/// Construct a TypeError when a function is called on the wrong # of arguments.\nfn wrong_num_args(function_name: String, wanted: Int, got: Int) -> EvalError {\n  TypeError(\n    function_name\n    <> \" takes \"\n    <> int.to_string(wanted)\n    <> \" argument(s) but was given \"\n    <> int.to_string(got),\n  )\n}\n\n/// A short description for error messages that omits list or record contents.\nfn describe(v: Value) -> String {\n  case v {\n    VList(_) -> \"a list\"\n    VData(tag, _) -> \"a \" <> tag <> \" record\"\n    VFunc(f) -> \"the function \" <> f.name\n    _ -> string.inspect(v)\n  }\n}\n","new_content_size":12960,"new_hash":"f0eb12c28202fdb7b4396130021b5c537973510c3b17283fc50c1c2fb45fb205","old_hash":"b2d67c80bbbd605d45eb9cf3365a64a9a04aa1dd5866c65e701699b1f6d15094","operation":"modify","path":"src/evaluator.gleam"},"hash":"a284b8b337c01ed1666472968e6ff54bc878f9a953ab76c25b43fd91fc17fe0f","kind":"fs.external_change","prev_hash":"c533d342aeabb692241801bda70138c048d310c4c11e9eb5631584868a22d482","seq":11011,"t":120468436,"wall":"2026-11-14T08:36:22.341Z"}
{"data":{"diff_size":24,"new_content":"//// The interpreter, which evaluates the program that the parser produces.\n\nimport errors.{type EvalError, MissingFunction, TypeError}\nimport gleam/dict.{type Dict}\nimport gleam/int\nimport gleam/list\nimport gleam/option.{type Option, None, Some}\nimport gleam/result\nimport gleam/string\nimport limits\nimport mutable_dict.{type MutableDict}\n\n// ── Types ─────────────────────────────────────────────────────────────────────\n\n/// The value of an expression evaluated in an environment.\npub type Value {\n  VBool(Bool)\n  VInt(Int)\n  VString(String)\n  VList(List(Value))\n  // A record (e.g., a Point or Line). The tag indicates its type.\n  VData(tag: String, fields: List(Value))\n  VFunc(Callable)\n}\n\n/// A record type has a constructor name and a list of field names.\npub type Constructor =\n  #(String, List(String))\n\n/// Rather than supporting new types, this interpreter uses a fixed set.\n/// Path's color field is optional at call sites (see builtins): omitted colour\n/// defaults to white when the Path value is built.\npub const constructors: List(Constructor) = [\n  #(\"Point\", [\"x\", \"y\"]),\n  #(\"Line\", [\"start\", \"end\"]),\n  #(\"Path\", [\"shape\", \"start\", \"end\", \"thickness\", \"color\"]),\n]\n\n/// The name-to-value bindings of a local frame (an immutable Gleam Dict).\npub type Bindings =\n  Dict(String, Value)\n\n/// The global frame is a mutable dictionary from names to values. It is mutable\n/// so that it can contain cycles: each top-level function in the global frame\n/// has the global frame as its env.\npub type GlobalFrame =\n  MutableDict(String, Value)\n\n/// An environment is a sequence of frames that includes a Local frame for each\n/// call to a user-defined function and a Global frame at the end.\npub type Env {\n  Local(bindings: Bindings, parent: Env)\n  Global(bindings: GlobalFrame)\n}\n\n/// A function value. A Builtin's run function implements its behavior, while a\n/// UserFn has a body Expr that is evaluated in a new frame whose parent is env.\npub type Callable {\n  Builtin(\n    name: String,\n    num_args: Int,\n    run: fn(List(Value)) -> Result(Value, EvalError),\n  )\n  UserFn(name: String, params: List(String), body: Expr, env: Env)\n}\n\n/// An Expr evaluates to a value when evaluated in an Env.\npub type Expr {\n  Var(String)\n  LiteralBool(Bool)\n  LiteralInt(Int)\n  LiteralString(String)\n  // [a, b, ..rest] where the optional rest must evaluate to a list.\n  LiteralList(elems: List(Expr), rest: Option(Expr))\n  // f(x, y) where the fn_expr must evaluate to a function.\n  Call(fn_expr: Expr, operands: List(Expr))\n  // An anonymous function: fn(x, y) { ... }.\n  Lambda(params: List(String), body: Expr)\n  // A case expression: case subject { pattern -> expr }\n  Case(subject: Expr, arms: List(Arm))\n  // let name = value followed by body, the expression on the next line.\n  Let(name: String, value: Expr, body: Expr)\n  // Accessing a field value by name: p.x, line.start, etc.\n  FieldAccess(record: Expr, field: String)\n  // A source-line marker the parser adds around each let and each case arm so\n  // that error messages can include the line where an expression appeared.\n  At(line: Int, expr: Expr)\n}\n\n/// An arm of a case expression: a Pattern and the Expr evaluated if it matches.\npub type Arm =\n  #(Pattern, Expr)\n\n/// A pattern in a case expression.\npub type Pattern {\n  PBool(Bool)\n  PInt(Int)\n  PWildcard\n  PVar(String)\n  PList(elems: List(Pattern), rest: Option(String))\n}\n\n// ── Evaluation ────────────────────────────────────────────────────────────────\n\n/// Evaluate an expression in an environment.\nfn eval(expr: Expr, env: Env) -> Result(Value, EvalError) {\n  limits.charge(1)\n  case expr {\n    Var(name) -> lookup(env, name)\n    LiteralBool(b) -> Ok(VBool(b))\n    LiteralInt(n) -> Ok(VInt(n))\n    LiteralList(elems, rest) -> eval_list(elems, rest, env)\n    Call(fn_expr, operands) ->\n      // YOUR CODE HERE (replace the code below)\n      // calls evaled f on operands \n      // case list.try_map(operands, fn(e) { eval(e, env) }) {\n      //   // if every call returns Ok, call apply\n      //   Ok(v_list) ->\n      //     case eval(fn_expr, env) {\n      //       Ok(f) -> apply(f, v_list)\n      //       Error(e) -> Error(e)\n      //     }\n      //   Error(e) -> Error(e)\n      // }\n\n      case eval(fn_expr, env) {\n        Ok(f) ->\n          case list.try_map(operands, fn(e) { eval(e, env) }) {\n            Ok(v_list) -> apply(f, v_list)\n            Error(e) -> Error(e)\n          }\n        Error(e) -> Error(e)\n      }\n\n    // Evaluate the expression v exactly once, then extend env to include\n    // the name bound to its value; finally, evaluate the body of the let.\n    Let(name, v, body) ->\n      case eval(v, env) {\n        Error(e) -> Error(e)\n        // YOUR CODE HERE (replace the code below)\n        Ok(value) -> eval(body, extend(env, [#(name, value)]))\n      }\n    Case(subject, arms) ->\n      // YOUR CODE HERE (replace the code below)\n      case eval(subject, env) {\n        Ok(val) ->\n          case find_arm(val, arms) {\n            Ok(#(bindings, body)) -> eval(body, extend(env, bindings))\n            Error(Nil) -> Error(errors.NoMatchingCase)\n          }\n        Error(e) -> Error(e)\n      }\n    Lambda(params, body) ->\n      // YOUR CODE HERE (replace the code below)\n      Ok(VFunc(UserFn(\"lambda\", params, body, env)))\n    FieldAccess(record, field) ->\n      case eval(record, env) {\n        Error(e) -> Error(e)\n        Ok(v) -> get_field(v, field)\n      }\n    // An error from this expression is on this line.\n    At(line, expr) -> result.map_error(eval(expr, env), errors.at_line(_, line))\n  }\n}\n\n/// Evaluate a list literal [a, b, ..rest].\nfn eval_list(\n  elems: List(Expr),\n  rest: Option(Expr),\n  env: Env,\n) -> Result(Value, EvalError) {\n  case list.try_map(elems, fn(e) { eval(e, env) }), rest {\n    Error(e), _ -> Error(e)\n    // YOUR CODE HERE (replace the code below)\n    Ok(head), None -> Ok(VList(head))\n    Ok(head), Some(r) ->\n      case eval(r, env) {\n        // YOUR CODE HERE (replace the code below)\n        Ok(VList(tail)) -> Ok(VList(list.append(head, tail)))\n        Ok(other) -> Ok(VList([other]))\n        Error(e) -> Error(e)\n      }\n  }\n}\n\n/// Apply a function value to already-evaluated arguments. Every application costs\n/// one step, even of a built-in.\npub fn apply(f: Value, args: List(Value)) -> Result(Value, EvalError) {\n  limits.charge(1)\n  case f {\n    VFunc(callable) -> {\n      let wanted = num_params(callable)\n      case list.length(args) == wanted {\n        False -> Error(wrong_num_args(callable.name, wanted, list.length(args)))\n        True ->\n          case callable {\n            Builtin(_, _, run) ->\n              // YOUR CODE HERE (replace the code below)\n              run(args)\n            UserFn(_, params, body, parent) ->\n              // YOUR CODE HERE (replace the code below)\n              eval(body, Local(dict.from_list(list.zip(params, args)), parent))\n          }\n      }\n    }\n    _ -> Error(TypeError(\"calling a value that is not a function\"))\n  }\n}\n\n/// How many arguments a function takes.\nfn num_params(callable: Callable) -> Int {\n  case callable {\n    Builtin(_, num_args, _) -> num_args\n    UserFn(_, params, _, _) -> list.length(params)\n  }\n}\n\n/// The value of a record's field, found by its position in constructors.\nfn get_field(v: Value, field: String) -> Result(Value, EvalError) {\n  case v {\n    VData(tag, values) -> {\n      let names = result.unwrap(list.key_find(constructors, tag), [])\n      case list.key_find(list.zip(names, values), field) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> Error(TypeError(\"a \" <> tag <> \" has no .\" <> field))\n      }\n    }\n    _ ->\n      Error(TypeError(\".\" <> field <> \" expects a record, got \" <> describe(v)))\n  }\n}\n\n/// The value bound to name in env. A name is looked up exactly as in an\n/// environment diagram: check the current frame's bindings, then its\n/// parent's, and so on out to the Global frame. A name that no frame binds\n/// is an errors.UnboundVariable(name) error.\npub fn lookup(env: Env, name: String) -> Result(Value, EvalError) {\n  case env {\n    // Local(bindings, parent) ->\n    //   // YOUR CODE HERE (replace the code below)\n    //   Error(errors.NotImplemented(\n    //     \"lookup(\"\n    //     <> name\n    //     <> \") in Local(\"\n    //     <> string.inspect(dict.keys(bindings))\n    //     <> \", \"\n    //     <> string.inspect(parent)\n    //     <> \")\",\n    //   ))\n    Local(bindings, parent) ->\n      case dict.get(bindings, name) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> lookup(parent, name)\n      }\n    Global(bindings) ->\n      case mutable_dict.get(bindings, name) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> Error(errors.UnboundVariable(name))\n      }\n  }\n}\n\n// ── Pattern matching ──────────────────────────────────────────────────────────\n\n/// The bindings and body of the first arm whose pattern matches value, or\n/// Error(Nil) if no pattern matches.\npub fn find_arm(\n  value: Value,\n  arms: List(Arm),\n) -> Result(#(List(#(String, Value)), Expr), Nil) {\n  case arms {\n    [] -> Error(Nil)\n    [#(pattern, body), ..rest] ->\n      case match_pattern(pattern, value) {\n        Ok(bindings) -> Ok(#(bindings, body))\n        Error(Nil) -> find_arm(value, rest)\n      }\n  }\n}\n\n/// The names that pattern binds if it matches value, or Error(Nil) if it doesn't.\nfn match_pattern(\n  pattern: Pattern,\n  value: Value,\n) -> Result(List(#(String, Value)), Nil) {\n  case pattern, value {\n    PBool(b1), VBool(b2) if b1 == b2 -> Ok([])\n    PInt(n1), VInt(n2) if n1 == n2 -> Ok([])\n    PWildcard, _ -> Ok([])\n    // YOUR CODE HERE\n    PVar(name), _ -> Ok([#(name, value)])\n    PList(elems, rest), VList(vs) -> match_list(elems, rest, vs)\n    _, _ -> Error(Nil)\n  }\n}\n\n/// The names that the list pattern [elems, ..rest] binds if it matches the values\n/// vs, or Error(Nil) if it doesn't.\nfn match_list(\n  elems: List(Pattern),\n  rest: Option(String),\n  vs: List(Value),\n) -> Result(List(#(String, Value)), Nil) {\n  case elems, rest, vs {\n    [], None, [] -> Ok([])\n    // YOUR CODE HERE ( replace the code below)\n    // elems is empty, but there is a rest\n    [], Some(x), _ -> {\n      Ok([#(x, VList(vs))])\n    }\n    // YOUR CODE HERE\n    [a, ..elems_rest], _, [vs_elems, ..vs_rest] ->\n      case match_pattern(a, vs_elems), match_list(elems_rest, rest, vs_rest) {\n        Ok(elem_bindings), Ok(rest_bindings) ->\n          Ok(list.append(elem_bindings, rest_bindings))\n        _, _ -> Error(Nil)\n      }\n    _, _, _ -> Error(Nil)\n  }\n}\n\n// ── Running a program ─────────────────────────────────────────────────────────\n\n/// Call the function named function in the global frame on args.\npub fn run(\n  function: String,\n  args: List(Value),\n  global: GlobalFrame,\n) -> Result(Value, EvalError) {\n  use <- limits.guarded\n  // The function's body is evaluated here rather than through apply, so that\n  // a program runs even before apply can call user-defined functions.\n  case mutable_dict.get(global, function) {\n    Ok(VFunc(UserFn(_, params, body, env))) ->\n      case list.length(params) == list.length(args) {\n        True -> eval(body, Local(dict.from_list(list.zip(params, args)), env))\n        False -> Error(MissingFunction(function, list.length(args)))\n      }\n    _ -> Error(MissingFunction(function, list.length(args)))\n  }\n}\n\n// ── Helpers ──────────────────────────────────────────────────────────────────\n\n/// The environment with the `new` bindings added to the current frame, each\n/// replacing any earlier binding of the same name in that frame. A let and a\n/// case arm bind this way.\npub fn extend(env: Env, new: List(#(String, Value))) -> Env {\n  case env {\n    Local(existing, parent) ->\n      Local(dict.merge(existing, dict.from_list(new)), parent)\n    // Global is never extended\n    Global(_) -> env\n  }\n}\n\n/// Construct a TypeError when a function is called on the wrong # of arguments.\nfn wrong_num_args(function_name: String, wanted: Int, got: Int) -> EvalError {\n  TypeError(\n    function_name\n    <> \" takes \"\n    <> int.to_string(wanted)\n    <> \" argument(s) but was given \"\n    <> int.to_string(got),\n  )\n}\n\n/// A short description for error messages that omits list or record contents.\nfn describe(v: Value) -> String {\n  case v {\n    VList(_) -> \"a list\"\n    VData(tag, _) -> \"a \" <> tag <> \" record\"\n    VFunc(f) -> \"the function \" <> f.name\n    _ -> string.inspect(v)\n  }\n}\n","new_content_size":12984,"new_hash":"ca0b0ed5d66547317e610126f36f2e06aa8a064a390c3ee8f3e367d4379246b2","old_hash":"f0eb12c28202fdb7b4396130021b5c537973510c3b17283fc50c1c2fb45fb205","operation":"modify","path":"src/evaluator.gleam"},"hash":"42b63707e90350b63c6108b155f00efb17c9f1b0b7d7ee636f6b0d8e03bade23","kind":"fs.external_change","prev_hash":"a284b8b337c01ed1666472968e6ff54bc878f9a953ab76c25b43fd91fc17fe0f","seq":11012,"t":120473589,"wall":"2026-11-14T08:36:27.495Z"}
{"data":{"diff_size":39,"new_content":"//// The interpreter, which evaluates the program that the parser produces.\n\nimport errors.{type EvalError, MissingFunction, TypeError}\nimport gleam/dict.{type Dict}\nimport gleam/int\nimport gleam/list\nimport gleam/option.{type Option, None, Some}\nimport gleam/result\nimport gleam/string\nimport limits\nimport mutable_dict.{type MutableDict}\n\n// ── Types ─────────────────────────────────────────────────────────────────────\n\n/// The value of an expression evaluated in an environment.\npub type Value {\n  VBool(Bool)\n  VInt(Int)\n  VString(String)\n  VList(List(Value))\n  // A record (e.g., a Point or Line). The tag indicates its type.\n  VData(tag: String, fields: List(Value))\n  VFunc(Callable)\n}\n\n/// A record type has a constructor name and a list of field names.\npub type Constructor =\n  #(String, List(String))\n\n/// Rather than supporting new types, this interpreter uses a fixed set.\n/// Path's color field is optional at call sites (see builtins): omitted colour\n/// defaults to white when the Path value is built.\npub const constructors: List(Constructor) = [\n  #(\"Point\", [\"x\", \"y\"]),\n  #(\"Line\", [\"start\", \"end\"]),\n  #(\"Path\", [\"shape\", \"start\", \"end\", \"thickness\", \"color\"]),\n]\n\n/// The name-to-value bindings of a local frame (an immutable Gleam Dict).\npub type Bindings =\n  Dict(String, Value)\n\n/// The global frame is a mutable dictionary from names to values. It is mutable\n/// so that it can contain cycles: each top-level function in the global frame\n/// has the global frame as its env.\npub type GlobalFrame =\n  MutableDict(String, Value)\n\n/// An environment is a sequence of frames that includes a Local frame for each\n/// call to a user-defined function and a Global frame at the end.\npub type Env {\n  Local(bindings: Bindings, parent: Env)\n  Global(bindings: GlobalFrame)\n}\n\n/// A function value. A Builtin's run function implements its behavior, while a\n/// UserFn has a body Expr that is evaluated in a new frame whose parent is env.\npub type Callable {\n  Builtin(\n    name: String,\n    num_args: Int,\n    run: fn(List(Value)) -> Result(Value, EvalError),\n  )\n  UserFn(name: String, params: List(String), body: Expr, env: Env)\n}\n\n/// An Expr evaluates to a value when evaluated in an Env.\npub type Expr {\n  Var(String)\n  LiteralBool(Bool)\n  LiteralInt(Int)\n  LiteralString(String)\n  // [a, b, ..rest] where the optional rest must evaluate to a list.\n  LiteralList(elems: List(Expr), rest: Option(Expr))\n  // f(x, y) where the fn_expr must evaluate to a function.\n  Call(fn_expr: Expr, operands: List(Expr))\n  // An anonymous function: fn(x, y) { ... }.\n  Lambda(params: List(String), body: Expr)\n  // A case expression: case subject { pattern -> expr }\n  Case(subject: Expr, arms: List(Arm))\n  // let name = value followed by body, the expression on the next line.\n  Let(name: String, value: Expr, body: Expr)\n  // Accessing a field value by name: p.x, line.start, etc.\n  FieldAccess(record: Expr, field: String)\n  // A source-line marker the parser adds around each let and each case arm so\n  // that error messages can include the line where an expression appeared.\n  At(line: Int, expr: Expr)\n}\n\n/// An arm of a case expression: a Pattern and the Expr evaluated if it matches.\npub type Arm =\n  #(Pattern, Expr)\n\n/// A pattern in a case expression.\npub type Pattern {\n  PBool(Bool)\n  PInt(Int)\n  PWildcard\n  PVar(String)\n  PList(elems: List(Pattern), rest: Option(String))\n}\n\n// ── Evaluation ────────────────────────────────────────────────────────────────\n\n/// Evaluate an expression in an environment.\nfn eval(expr: Expr, env: Env) -> Result(Value, EvalError) {\n  limits.charge(1)\n  case expr {\n    Var(name) -> lookup(env, name)\n    LiteralBool(b) -> Ok(VBool(b))\n    LiteralInt(n) -> Ok(VInt(n))\n    LiteralString(s) -> Ok(VString(s))\n    LiteralList(elems, rest) -> eval_list(elems, rest, env)\n    Call(fn_expr, operands) ->\n      // YOUR CODE HERE (replace the code below)\n      // calls evaled f on operands \n      // case list.try_map(operands, fn(e) { eval(e, env) }) {\n      //   // if every call returns Ok, call apply\n      //   Ok(v_list) ->\n      //     case eval(fn_expr, env) {\n      //       Ok(f) -> apply(f, v_list)\n      //       Error(e) -> Error(e)\n      //     }\n      //   Error(e) -> Error(e)\n      // }\n\n      case eval(fn_expr, env) {\n        Ok(f) ->\n          case list.try_map(operands, fn(e) { eval(e, env) }) {\n            Ok(v_list) -> apply(f, v_list)\n            Error(e) -> Error(e)\n          }\n        Error(e) -> Error(e)\n      }\n\n    // Evaluate the expression v exactly once, then extend env to include\n    // the name bound to its value; finally, evaluate the body of the let.\n    Let(name, v, body) ->\n      case eval(v, env) {\n        Error(e) -> Error(e)\n        // YOUR CODE HERE (replace the code below)\n        Ok(value) -> eval(body, extend(env, [#(name, value)]))\n      }\n    Case(subject, arms) ->\n      // YOUR CODE HERE (replace the code below)\n      case eval(subject, env) {\n        Ok(val) ->\n          case find_arm(val, arms) {\n            Ok(#(bindings, body)) -> eval(body, extend(env, bindings))\n            Error(Nil) -> Error(errors.NoMatchingCase)\n          }\n        Error(e) -> Error(e)\n      }\n    Lambda(params, body) ->\n      // YOUR CODE HERE (replace the code below)\n      Ok(VFunc(UserFn(\"lambda\", params, body, env)))\n    FieldAccess(record, field) ->\n      case eval(record, env) {\n        Error(e) -> Error(e)\n        Ok(v) -> get_field(v, field)\n      }\n    // An error from this expression is on this line.\n    At(line, expr) -> result.map_error(eval(expr, env), errors.at_line(_, line))\n  }\n}\n\n/// Evaluate a list literal [a, b, ..rest].\nfn eval_list(\n  elems: List(Expr),\n  rest: Option(Expr),\n  env: Env,\n) -> Result(Value, EvalError) {\n  case list.try_map(elems, fn(e) { eval(e, env) }), rest {\n    Error(e), _ -> Error(e)\n    // YOUR CODE HERE (replace the code below)\n    Ok(head), None -> Ok(VList(head))\n    Ok(head), Some(r) ->\n      case eval(r, env) {\n        // YOUR CODE HERE (replace the code below)\n        Ok(VList(tail)) -> Ok(VList(list.append(head, tail)))\n        Ok(other) -> Ok(VList([other]))\n        Error(e) -> Error(e)\n      }\n  }\n}\n\n/// Apply a function value to already-evaluated arguments. Every application costs\n/// one step, even of a built-in.\npub fn apply(f: Value, args: List(Value)) -> Result(Value, EvalError) {\n  limits.charge(1)\n  case f {\n    VFunc(callable) -> {\n      let wanted = num_params(callable)\n      case list.length(args) == wanted {\n        False -> Error(wrong_num_args(callable.name, wanted, list.length(args)))\n        True ->\n          case callable {\n            Builtin(_, _, run) ->\n              // YOUR CODE HERE (replace the code below)\n              run(args)\n            UserFn(_, params, body, parent) ->\n              // YOUR CODE HERE (replace the code below)\n              eval(body, Local(dict.from_list(list.zip(params, args)), parent))\n          }\n      }\n    }\n    _ -> Error(TypeError(\"calling a value that is not a function\"))\n  }\n}\n\n/// How many arguments a function takes.\nfn num_params(callable: Callable) -> Int {\n  case callable {\n    Builtin(_, num_args, _) -> num_args\n    UserFn(_, params, _, _) -> list.length(params)\n  }\n}\n\n/// The value of a record's field, found by its position in constructors.\nfn get_field(v: Value, field: String) -> Result(Value, EvalError) {\n  case v {\n    VData(tag, values) -> {\n      let names = result.unwrap(list.key_find(constructors, tag), [])\n      case list.key_find(list.zip(names, values), field) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> Error(TypeError(\"a \" <> tag <> \" has no .\" <> field))\n      }\n    }\n    _ ->\n      Error(TypeError(\".\" <> field <> \" expects a record, got \" <> describe(v)))\n  }\n}\n\n/// The value bound to name in env. A name is looked up exactly as in an\n/// environment diagram: check the current frame's bindings, then its\n/// parent's, and so on out to the Global frame. A name that no frame binds\n/// is an errors.UnboundVariable(name) error.\npub fn lookup(env: Env, name: String) -> Result(Value, EvalError) {\n  case env {\n    // Local(bindings, parent) ->\n    //   // YOUR CODE HERE (replace the code below)\n    //   Error(errors.NotImplemented(\n    //     \"lookup(\"\n    //     <> name\n    //     <> \") in Local(\"\n    //     <> string.inspect(dict.keys(bindings))\n    //     <> \", \"\n    //     <> string.inspect(parent)\n    //     <> \")\",\n    //   ))\n    Local(bindings, parent) ->\n      case dict.get(bindings, name) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> lookup(parent, name)\n      }\n    Global(bindings) ->\n      case mutable_dict.get(bindings, name) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> Error(errors.UnboundVariable(name))\n      }\n  }\n}\n\n// ── Pattern matching ──────────────────────────────────────────────────────────\n\n/// The bindings and body of the first arm whose pattern matches value, or\n/// Error(Nil) if no pattern matches.\npub fn find_arm(\n  value: Value,\n  arms: List(Arm),\n) -> Result(#(List(#(String, Value)), Expr), Nil) {\n  case arms {\n    [] -> Error(Nil)\n    [#(pattern, body), ..rest] ->\n      case match_pattern(pattern, value) {\n        Ok(bindings) -> Ok(#(bindings, body))\n        Error(Nil) -> find_arm(value, rest)\n      }\n  }\n}\n\n/// The names that pattern binds if it matches value, or Error(Nil) if it doesn't.\nfn match_pattern(\n  pattern: Pattern,\n  value: Value,\n) -> Result(List(#(String, Value)), Nil) {\n  case pattern, value {\n    PBool(b1), VBool(b2) if b1 == b2 -> Ok([])\n    PInt(n1), VInt(n2) if n1 == n2 -> Ok([])\n    PWildcard, _ -> Ok([])\n    // YOUR CODE HERE\n    PVar(name), _ -> Ok([#(name, value)])\n    PList(elems, rest), VList(vs) -> match_list(elems, rest, vs)\n    _, _ -> Error(Nil)\n  }\n}\n\n/// The names that the list pattern [elems, ..rest] binds if it matches the values\n/// vs, or Error(Nil) if it doesn't.\nfn match_list(\n  elems: List(Pattern),\n  rest: Option(String),\n  vs: List(Value),\n) -> Result(List(#(String, Value)), Nil) {\n  case elems, rest, vs {\n    [], None, [] -> Ok([])\n    // YOUR CODE HERE ( replace the code below)\n    // elems is empty, but there is a rest\n    [], Some(x), _ -> {\n      Ok([#(x, VList(vs))])\n    }\n    // YOUR CODE HERE\n    [a, ..elems_rest], _, [vs_elems, ..vs_rest] ->\n      case match_pattern(a, vs_elems), match_list(elems_rest, rest, vs_rest) {\n        Ok(elem_bindings), Ok(rest_bindings) ->\n          Ok(list.append(elem_bindings, rest_bindings))\n        _, _ -> Error(Nil)\n      }\n    _, _, _ -> Error(Nil)\n  }\n}\n\n// ── Running a program ─────────────────────────────────────────────────────────\n\n/// Call the function named function in the global frame on args.\npub fn run(\n  function: String,\n  args: List(Value),\n  global: GlobalFrame,\n) -> Result(Value, EvalError) {\n  use <- limits.guarded\n  // The function's body is evaluated here rather than through apply, so that\n  // a program runs even before apply can call user-defined functions.\n  case mutable_dict.get(global, function) {\n    Ok(VFunc(UserFn(_, params, body, env))) ->\n      case list.length(params) == list.length(args) {\n        True -> eval(body, Local(dict.from_list(list.zip(params, args)), env))\n        False -> Error(MissingFunction(function, list.length(args)))\n      }\n    _ -> Error(MissingFunction(function, list.length(args)))\n  }\n}\n\n// ── Helpers ──────────────────────────────────────────────────────────────────\n\n/// The environment with the `new` bindings added to the current frame, each\n/// replacing any earlier binding of the same name in that frame. A let and a\n/// case arm bind this way.\npub fn extend(env: Env, new: List(#(String, Value))) -> Env {\n  case env {\n    Local(existing, parent) ->\n      Local(dict.merge(existing, dict.from_list(new)), parent)\n    // Global is never extended\n    Global(_) -> env\n  }\n}\n\n/// Construct a TypeError when a function is called on the wrong # of arguments.\nfn wrong_num_args(function_name: String, wanted: Int, got: Int) -> EvalError {\n  TypeError(\n    function_name\n    <> \" takes \"\n    <> int.to_string(wanted)\n    <> \" argument(s) but was given \"\n    <> int.to_string(got),\n  )\n}\n\n/// A short description for error messages that omits list or record contents.\nfn describe(v: Value) -> String {\n  case v {\n    VList(_) -> \"a list\"\n    VData(tag, _) -> \"a \" <> tag <> \" record\"\n    VFunc(f) -> \"the function \" <> f.name\n    _ -> string.inspect(v)\n  }\n}\n","new_content_size":13023,"new_hash":"3d16c946aa1a726c77d050e325b5a9ce9bf71c4cc435e62b37f0efe1a27c5389","old_hash":"ca0b0ed5d66547317e610126f36f2e06aa8a064a390c3ee8f3e367d4379246b2","operation":"modify","path":"src/evaluator.gleam"},"hash":"439e7ea3fafbdc64ee97df52f9c2fe646801dc7025e32ecabc6e295db202fddb","kind":"fs.external_change","prev_hash":"42b63707e90350b63c6108b155f00efb17c9f1b0b7d7ee636f6b0d8e03bade23","seq":11013,"t":120475091,"wall":"2026-11-14T08:36:28.997Z"}
{"data":{"diff_size":177,"new_content":"//// The interpreter, which evaluates the program that the parser produces.\n\nimport errors.{type EvalError, MissingFunction, TypeError}\nimport gleam/dict.{type Dict}\nimport gleam/int\nimport gleam/list\nimport gleam/option.{type Option, None, Some}\nimport gleam/result\nimport gleam/string\nimport limits\nimport mutable_dict.{type MutableDict}\n\n// ── Types ─────────────────────────────────────────────────────────────────────\n\n/// The value of an expression evaluated in an environment.\npub type Value {\n  VBool(Bool)\n  VInt(Int)\n  VString(String)\n  VList(List(Value))\n  // A record (e.g., a Point or Line). The tag indicates its type.\n  VData(tag: String, fields: List(Value))\n  VFunc(Callable)\n}\n\n/// A record type has a constructor name and a list of field names.\npub type Constructor =\n  #(String, List(String))\n\n/// Rather than supporting new types, this interpreter uses a fixed set.\n/// Path's color field is optional at call sites (see builtins): omitted colour\n/// defaults to white when the Path value is built.\npub const constructors: List(Constructor) = [\n  #(\"Point\", [\"x\", \"y\"]),\n  #(\"Line\", [\"start\", \"end\"]),\n  #(\"Path\", [\"shape\", \"start\", \"end\", \"thickness\", \"color\"]),\n]\n\n/// The name-to-value bindings of a local frame (an immutable Gleam Dict).\npub type Bindings =\n  Dict(String, Value)\n\n/// The global frame is a mutable dictionary from names to values. It is mutable\n/// so that it can contain cycles: each top-level function in the global frame\n/// has the global frame as its env.\npub type GlobalFrame =\n  MutableDict(String, Value)\n\n/// An environment is a sequence of frames that includes a Local frame for each\n/// call to a user-defined function and a Global frame at the end.\npub type Env {\n  Local(bindings: Bindings, parent: Env)\n  Global(bindings: GlobalFrame)\n}\n\n/// A function value. A Builtin's run function implements its behavior, while a\n/// UserFn has a body Expr that is evaluated in a new frame whose parent is env.\npub type Callable {\n  Builtin(\n    name: String,\n    num_args: Int,\n    run: fn(List(Value)) -> Result(Value, EvalError),\n  )\n  UserFn(name: String, params: List(String), body: Expr, env: Env)\n}\n\n/// An Expr evaluates to a value when evaluated in an Env.\npub type Expr {\n  Var(String)\n  LiteralBool(Bool)\n  LiteralInt(Int)\n  LiteralString(String)\n  // [a, b, ..rest] where the optional rest must evaluate to a list.\n  LiteralList(elems: List(Expr), rest: Option(Expr))\n  // f(x, y) where the fn_expr must evaluate to a function.\n  Call(fn_expr: Expr, operands: List(Expr))\n  // An anonymous function: fn(x, y) { ... }.\n  Lambda(params: List(String), body: Expr)\n  // A case expression: case subject { pattern -> expr }\n  Case(subject: Expr, arms: List(Arm))\n  // let name = value followed by body, the expression on the next line.\n  Let(name: String, value: Expr, body: Expr)\n  // Accessing a field value by name: p.x, line.start, etc.\n  FieldAccess(record: Expr, field: String)\n  // A source-line marker the parser adds around each let and each case arm so\n  // that error messages can include the line where an expression appeared.\n  At(line: Int, expr: Expr)\n}\n\n/// An arm of a case expression: a Pattern and the Expr evaluated if it matches.\npub type Arm =\n  #(Pattern, Expr)\n\n/// A pattern in a case expression.\npub type Pattern {\n  PBool(Bool)\n  PInt(Int)\n  PWildcard\n  PVar(String)\n  PList(elems: List(Pattern), rest: Option(String))\n}\n\n// ── Evaluation ────────────────────────────────────────────────────────────────\n\n/// Evaluate an expression in an environment.\nfn eval(expr: Expr, env: Env) -> Result(Value, EvalError) {\n  limits.charge(1)\n  case expr {\n    Var(name) -> lookup(env, name)\n    LiteralBool(b) -> Ok(VBool(b))\n    LiteralInt(n) -> Ok(VInt(n))\n    LiteralString(s) -> Ok(VString(s))\n    LiteralList(elems, rest) -> eval_list(elems, rest, env)\n    Call(fn_expr, operands) ->\n      // YOUR CODE HERE (replace the code below)\n      // calls evaled f on operands \n      // case list.try_map(operands, fn(e) { eval(e, env) }) {\n      //   // if every call returns Ok, call apply\n      //   Ok(v_list) ->\n      //     case eval(fn_expr, env) {\n      //       Ok(f) -> apply(f, v_list)\n      //       Error(e) -> Error(e)\n      //     }\n      //   Error(e) -> Error(e)\n      // }\n\n      case eval(fn_expr, env) {\n        Ok(f) ->\n          case list.try_map(operands, fn(e) { eval(e, env) }) {\n            Ok(v_list) -> apply(f, v_list)\n            Error(e) -> Error(e)\n          }\n        Error(e) -> Error(e)\n      }\n\n    // Evaluate the expression v exactly once, then extend env to include\n    // the name bound to its value; finally, evaluate the body of the let.\n    Let(name, v, body) ->\n      case eval(v, env) {\n        Error(e) -> Error(e)\n        // YOUR CODE HERE (replace the code below)\n        Ok(value) -> eval(body, extend(env, [#(name, value)]))\n      }\n    Case(subject, arms) ->\n      // YOUR CODE HERE (replace the code below)\n      case eval(subject, env) {\n        Ok(val) ->\n          case find_arm(val, arms) {\n            Ok(#(bindings, body)) -> eval(body, extend(env, bindings))\n            Error(Nil) -> Error(errors.NoMatchingCase)\n          }\n        Error(e) -> Error(e)\n      }\n    Lambda(params, body) ->\n      // YOUR CODE HERE (replace the code below)\n      Ok(VFunc(UserFn(\"lambda\", params, body, env)))\n    FieldAccess(record, field) ->\n      case eval(record, env) {\n        Error(e) -> Error(e)\n        Ok(v) -> get_field(v, field)\n      }\n    // An error from this expression is on this line.\n    At(line, expr) -> result.map_error(eval(expr, env), errors.at_line(_, line))\n  }\n}\n\n/// Evaluate a list literal [a, b, ..rest].\nfn eval_list(\n  elems: List(Expr),\n  rest: Option(Expr),\n  env: Env,\n) -> Result(Value, EvalError) {\n  case list.try_map(elems, fn(e) { eval(e, env) }), rest {\n    Error(e), _ -> Error(e)\n    // YOUR CODE HERE (replace the code below)\n    Ok(head), None -> Ok(VList(head))\n    Ok(head), Some(r) ->\n      case eval(r, env) {\n        // YOUR CODE HERE (replace the code below)\n        Ok(VList(tail)) -> Ok(VList(list.append(head, tail)))\n        Ok(other) -> Ok(VList([other]))\n        Error(e) -> Error(e)\n      }\n  }\n}\n\n/// Apply a function value to already-evaluated arguments. Every application costs\n/// one step, even of a built-in.\npub fn apply(f: Value, args: List(Value)) -> Result(Value, EvalError) {\n  limits.charge(1)\n  case f {\n    VFunc(callable) -> {\n      let wanted = num_params(callable)\n      // A negative arity means the built-in checks argument count itself\n      // (used by Path, whose color argument is optional).\n      let arity_ok = wanted < 0 || list.length(args) == wanted\n      case arity_ok {\n        False -> Error(wrong_num_args(callable.name, wanted, list.length(args)))\n        True ->\n          case callable {\n            Builtin(_, _, run) ->\n              // YOUR CODE HERE (replace the code below)\n              run(args)\n            UserFn(_, params, body, parent) ->\n              // YOUR CODE HERE (replace the code below)\n              eval(body, Local(dict.from_list(list.zip(params, args)), parent))\n          }\n      }\n    }\n    _ -> Error(TypeError(\"calling a value that is not a function\"))\n  }\n}\n\n/// How many arguments a function takes.\nfn num_params(callable: Callable) -> Int {\n  case callable {\n    Builtin(_, num_args, _) -> num_args\n    UserFn(_, params, _, _) -> list.length(params)\n  }\n}\n\n/// The value of a record's field, found by its position in constructors.\nfn get_field(v: Value, field: String) -> Result(Value, EvalError) {\n  case v {\n    VData(tag, values) -> {\n      let names = result.unwrap(list.key_find(constructors, tag), [])\n      case list.key_find(list.zip(names, values), field) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> Error(TypeError(\"a \" <> tag <> \" has no .\" <> field))\n      }\n    }\n    _ ->\n      Error(TypeError(\".\" <> field <> \" expects a record, got \" <> describe(v)))\n  }\n}\n\n/// The value bound to name in env. A name is looked up exactly as in an\n/// environment diagram: check the current frame's bindings, then its\n/// parent's, and so on out to the Global frame. A name that no frame binds\n/// is an errors.UnboundVariable(name) error.\npub fn lookup(env: Env, name: String) -> Result(Value, EvalError) {\n  case env {\n    // Local(bindings, parent) ->\n    //   // YOUR CODE HERE (replace the code below)\n    //   Error(errors.NotImplemented(\n    //     \"lookup(\"\n    //     <> name\n    //     <> \") in Local(\"\n    //     <> string.inspect(dict.keys(bindings))\n    //     <> \", \"\n    //     <> string.inspect(parent)\n    //     <> \")\",\n    //   ))\n    Local(bindings, parent) ->\n      case dict.get(bindings, name) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> lookup(parent, name)\n      }\n    Global(bindings) ->\n      case mutable_dict.get(bindings, name) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> Error(errors.UnboundVariable(name))\n      }\n  }\n}\n\n// ── Pattern matching ──────────────────────────────────────────────────────────\n\n/// The bindings and body of the first arm whose pattern matches value, or\n/// Error(Nil) if no pattern matches.\npub fn find_arm(\n  value: Value,\n  arms: List(Arm),\n) -> Result(#(List(#(String, Value)), Expr), Nil) {\n  case arms {\n    [] -> Error(Nil)\n    [#(pattern, body), ..rest] ->\n      case match_pattern(pattern, value) {\n        Ok(bindings) -> Ok(#(bindings, body))\n        Error(Nil) -> find_arm(value, rest)\n      }\n  }\n}\n\n/// The names that pattern binds if it matches value, or Error(Nil) if it doesn't.\nfn match_pattern(\n  pattern: Pattern,\n  value: Value,\n) -> Result(List(#(String, Value)), Nil) {\n  case pattern, value {\n    PBool(b1), VBool(b2) if b1 == b2 -> Ok([])\n    PInt(n1), VInt(n2) if n1 == n2 -> Ok([])\n    PWildcard, _ -> Ok([])\n    // YOUR CODE HERE\n    PVar(name), _ -> Ok([#(name, value)])\n    PList(elems, rest), VList(vs) -> match_list(elems, rest, vs)\n    _, _ -> Error(Nil)\n  }\n}\n\n/// The names that the list pattern [elems, ..rest] binds if it matches the values\n/// vs, or Error(Nil) if it doesn't.\nfn match_list(\n  elems: List(Pattern),\n  rest: Option(String),\n  vs: List(Value),\n) -> Result(List(#(String, Value)), Nil) {\n  case elems, rest, vs {\n    [], None, [] -> Ok([])\n    // YOUR CODE HERE ( replace the code below)\n    // elems is empty, but there is a rest\n    [], Some(x), _ -> {\n      Ok([#(x, VList(vs))])\n    }\n    // YOUR CODE HERE\n    [a, ..elems_rest], _, [vs_elems, ..vs_rest] ->\n      case match_pattern(a, vs_elems), match_list(elems_rest, rest, vs_rest) {\n        Ok(elem_bindings), Ok(rest_bindings) ->\n          Ok(list.append(elem_bindings, rest_bindings))\n        _, _ -> Error(Nil)\n      }\n    _, _, _ -> Error(Nil)\n  }\n}\n\n// ── Running a program ─────────────────────────────────────────────────────────\n\n/// Call the function named function in the global frame on args.\npub fn run(\n  function: String,\n  args: List(Value),\n  global: GlobalFrame,\n) -> Result(Value, EvalError) {\n  use <- limits.guarded\n  // The function's body is evaluated here rather than through apply, so that\n  // a program runs even before apply can call user-defined functions.\n  case mutable_dict.get(global, function) {\n    Ok(VFunc(UserFn(_, params, body, env))) ->\n      case list.length(params) == list.length(args) {\n        True -> eval(body, Local(dict.from_list(list.zip(params, args)), env))\n        False -> Error(MissingFunction(function, list.length(args)))\n      }\n    _ -> Error(MissingFunction(function, list.length(args)))\n  }\n}\n\n// ── Helpers ──────────────────────────────────────────────────────────────────\n\n/// The environment with the `new` bindings added to the current frame, each\n/// replacing any earlier binding of the same name in that frame. A let and a\n/// case arm bind this way.\npub fn extend(env: Env, new: List(#(String, Value))) -> Env {\n  case env {\n    Local(existing, parent) ->\n      Local(dict.merge(existing, dict.from_list(new)), parent)\n    // Global is never extended\n    Global(_) -> env\n  }\n}\n\n/// Construct a TypeError when a function is called on the wrong # of arguments.\nfn wrong_num_args(function_name: String, wanted: Int, got: Int) -> EvalError {\n  TypeError(\n    function_name\n    <> \" takes \"\n    <> int.to_string(wanted)\n    <> \" argument(s) but was given \"\n    <> int.to_string(got),\n  )\n}\n\n/// A short description for error messages that omits list or record contents.\nfn describe(v: Value) -> String {\n  case v {\n    VList(_) -> \"a list\"\n    VData(tag, _) -> \"a \" <> tag <> \" record\"\n    VFunc(f) -> \"the function \" <> f.name\n    _ -> string.inspect(v)\n  }\n}\n","new_content_size":13200,"new_hash":"97f4dec72caa2f97d0374474768a9d1a3395f9536be5ebf3f819cedfa546033b","old_hash":"3d16c946aa1a726c77d050e325b5a9ce9bf71c4cc435e62b37f0efe1a27c5389","operation":"modify","path":"src/evaluator.gleam"},"hash":"3c2f6dc1acdccf09b47fe1831d2fc95b1c8cdf81237c6aa12de90a86bc211450","kind":"fs.external_change","prev_hash":"439e7ea3fafbdc64ee97df52f9c2fe646801dc7025e32ecabc6e295db202fddb","seq":11014,"t":120479288,"wall":"2026-11-14T08:36:33.194Z"}
{"data":{"diff_size":29,"new_content":"//// The interpreter, which evaluates the program that the parser produces.\n\nimport errors.{type EvalError, MissingFunction, TypeError}\nimport gleam/dict.{type Dict}\nimport gleam/int\nimport gleam/list\nimport gleam/option.{type Option, None, Some}\nimport gleam/result\nimport gleam/string\nimport limits\nimport mutable_dict.{type MutableDict}\n\n// ── Types ─────────────────────────────────────────────────────────────────────\n\n/// The value of an expression evaluated in an environment.\npub type Value {\n  VBool(Bool)\n  VInt(Int)\n  VString(String)\n  VList(List(Value))\n  // A record (e.g., a Point or Line). The tag indicates its type.\n  VData(tag: String, fields: List(Value))\n  VFunc(Callable)\n}\n\n/// A record type has a constructor name and a list of field names.\npub type Constructor =\n  #(String, List(String))\n\n/// Rather than supporting new types, this interpreter uses a fixed set.\n/// Path's color field is optional at call sites (see builtins): omitted colour\n/// defaults to white when the Path value is built.\npub const constructors: List(Constructor) = [\n  #(\"Point\", [\"x\", \"y\"]),\n  #(\"Line\", [\"start\", \"end\"]),\n  #(\"Path\", [\"shape\", \"start\", \"end\", \"thickness\", \"color\"]),\n]\n\n/// The name-to-value bindings of a local frame (an immutable Gleam Dict).\npub type Bindings =\n  Dict(String, Value)\n\n/// The global frame is a mutable dictionary from names to values. It is mutable\n/// so that it can contain cycles: each top-level function in the global frame\n/// has the global frame as its env.\npub type GlobalFrame =\n  MutableDict(String, Value)\n\n/// An environment is a sequence of frames that includes a Local frame for each\n/// call to a user-defined function and a Global frame at the end.\npub type Env {\n  Local(bindings: Bindings, parent: Env)\n  Global(bindings: GlobalFrame)\n}\n\n/// A function value. A Builtin's run function implements its behavior, while a\n/// UserFn has a body Expr that is evaluated in a new frame whose parent is env.\npub type Callable {\n  Builtin(\n    name: String,\n    num_args: Int,\n    run: fn(List(Value)) -> Result(Value, EvalError),\n  )\n  UserFn(name: String, params: List(String), body: Expr, env: Env)\n}\n\n/// An Expr evaluates to a value when evaluated in an Env.\npub type Expr {\n  Var(String)\n  LiteralBool(Bool)\n  LiteralInt(Int)\n  LiteralString(String)\n  // [a, b, ..rest] where the optional rest must evaluate to a list.\n  LiteralList(elems: List(Expr), rest: Option(Expr))\n  // f(x, y) where the fn_expr must evaluate to a function.\n  Call(fn_expr: Expr, operands: List(Expr))\n  // An anonymous function: fn(x, y) { ... }.\n  Lambda(params: List(String), body: Expr)\n  // A case expression: case subject { pattern -> expr }\n  Case(subject: Expr, arms: List(Arm))\n  // let name = value followed by body, the expression on the next line.\n  Let(name: String, value: Expr, body: Expr)\n  // Accessing a field value by name: p.x, line.start, etc.\n  FieldAccess(record: Expr, field: String)\n  // A source-line marker the parser adds around each let and each case arm so\n  // that error messages can include the line where an expression appeared.\n  At(line: Int, expr: Expr)\n}\n\n/// An arm of a case expression: a Pattern and the Expr evaluated if it matches.\npub type Arm =\n  #(Pattern, Expr)\n\n/// A pattern in a case expression.\npub type Pattern {\n  PBool(Bool)\n  PInt(Int)\n  PWildcard\n  PVar(String)\n  PList(elems: List(Pattern), rest: Option(String))\n}\n\n// ── Evaluation ────────────────────────────────────────────────────────────────\n\n/// Evaluate an expression in an environment.\nfn eval(expr: Expr, env: Env) -> Result(Value, EvalError) {\n  limits.charge(1)\n  case expr {\n    Var(name) -> lookup(env, name)\n    LiteralBool(b) -> Ok(VBool(b))\n    LiteralInt(n) -> Ok(VInt(n))\n    LiteralString(s) -> Ok(VString(s))\n    LiteralList(elems, rest) -> eval_list(elems, rest, env)\n    Call(fn_expr, operands) ->\n      // YOUR CODE HERE (replace the code below)\n      // calls evaled f on operands \n      // case list.try_map(operands, fn(e) { eval(e, env) }) {\n      //   // if every call returns Ok, call apply\n      //   Ok(v_list) ->\n      //     case eval(fn_expr, env) {\n      //       Ok(f) -> apply(f, v_list)\n      //       Error(e) -> Error(e)\n      //     }\n      //   Error(e) -> Error(e)\n      // }\n\n      case eval(fn_expr, env) {\n        Ok(f) ->\n          case list.try_map(operands, fn(e) { eval(e, env) }) {\n            Ok(v_list) -> apply(f, v_list)\n            Error(e) -> Error(e)\n          }\n        Error(e) -> Error(e)\n      }\n\n    // Evaluate the expression v exactly once, then extend env to include\n    // the name bound to its value; finally, evaluate the body of the let.\n    Let(name, v, body) ->\n      case eval(v, env) {\n        Error(e) -> Error(e)\n        // YOUR CODE HERE (replace the code below)\n        Ok(value) -> eval(body, extend(env, [#(name, value)]))\n      }\n    Case(subject, arms) ->\n      // YOUR CODE HERE (replace the code below)\n      case eval(subject, env) {\n        Ok(val) ->\n          case find_arm(val, arms) {\n            Ok(#(bindings, body)) -> eval(body, extend(env, bindings))\n            Error(Nil) -> Error(errors.NoMatchingCase)\n          }\n        Error(e) -> Error(e)\n      }\n    Lambda(params, body) ->\n      // YOUR CODE HERE (replace the code below)\n      Ok(VFunc(UserFn(\"lambda\", params, body, env)))\n    FieldAccess(record, field) ->\n      case eval(record, env) {\n        Error(e) -> Error(e)\n        Ok(v) -> get_field(v, field)\n      }\n    // An error from this expression is on this line.\n    At(line, expr) -> result.map_error(eval(expr, env), errors.at_line(_, line))\n  }\n}\n\n/// Evaluate a list literal [a, b, ..rest].\nfn eval_list(\n  elems: List(Expr),\n  rest: Option(Expr),\n  env: Env,\n) -> Result(Value, EvalError) {\n  case list.try_map(elems, fn(e) { eval(e, env) }), rest {\n    Error(e), _ -> Error(e)\n    // YOUR CODE HERE (replace the code below)\n    Ok(head), None -> Ok(VList(head))\n    Ok(head), Some(r) ->\n      case eval(r, env) {\n        // YOUR CODE HERE (replace the code below)\n        Ok(VList(tail)) -> Ok(VList(list.append(head, tail)))\n        Ok(other) -> Ok(VList([other]))\n        Error(e) -> Error(e)\n      }\n  }\n}\n\n/// Apply a function value to already-evaluated arguments. Every application costs\n/// one step, even of a built-in.\npub fn apply(f: Value, args: List(Value)) -> Result(Value, EvalError) {\n  limits.charge(1)\n  case f {\n    VFunc(callable) -> {\n      let wanted = num_params(callable)\n      // A negative arity means the built-in checks argument count itself\n      // (used by Path, whose color argument is optional).\n      let arity_ok = wanted < 0 || list.length(args) == wanted\n      case arity_ok {\n        False -> Error(wrong_num_args(callable.name, wanted, list.length(args)))\n        True ->\n          case callable {\n            Builtin(_, _, run) ->\n              // YOUR CODE HERE (replace the code below)\n              run(args)\n            UserFn(_, params, body, parent) ->\n              // YOUR CODE HERE (replace the code below)\n              eval(body, Local(dict.from_list(list.zip(params, args)), parent))\n          }\n      }\n    }\n    _ -> Error(TypeError(\"calling a value that is not a function\"))\n  }\n}\n\n/// How many arguments a function takes.\nfn num_params(callable: Callable) -> Int {\n  case callable {\n    Builtin(_, num_args, _) -> num_args\n    UserFn(_, params, _, _) -> list.length(params)\n  }\n}\n\n/// The value of a record's field, found by its position in constructors.\nfn get_field(v: Value, field: String) -> Result(Value, EvalError) {\n  case v {\n    VData(tag, values) -> {\n      let names = result.unwrap(list.key_find(constructors, tag), [])\n      case list.key_find(list.zip(names, values), field) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> Error(TypeError(\"a \" <> tag <> \" has no .\" <> field))\n      }\n    }\n    _ ->\n      Error(TypeError(\".\" <> field <> \" expects a record, got \" <> describe(v)))\n  }\n}\n\n/// The value bound to name in env. A name is looked up exactly as in an\n/// environment diagram: check the current frame's bindings, then its\n/// parent's, and so on out to the Global frame. A name that no frame binds\n/// is an errors.UnboundVariable(name) error.\npub fn lookup(env: Env, name: String) -> Result(Value, EvalError) {\n  case env {\n    // Local(bindings, parent) ->\n    //   // YOUR CODE HERE (replace the code below)\n    //   Error(errors.NotImplemented(\n    //     \"lookup(\"\n    //     <> name\n    //     <> \") in Local(\"\n    //     <> string.inspect(dict.keys(bindings))\n    //     <> \", \"\n    //     <> string.inspect(parent)\n    //     <> \")\",\n    //   ))\n    Local(bindings, parent) ->\n      case dict.get(bindings, name) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> lookup(parent, name)\n      }\n    Global(bindings) ->\n      case mutable_dict.get(bindings, name) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> Error(errors.UnboundVariable(name))\n      }\n  }\n}\n\n// ── Pattern matching ──────────────────────────────────────────────────────────\n\n/// The bindings and body of the first arm whose pattern matches value, or\n/// Error(Nil) if no pattern matches.\npub fn find_arm(\n  value: Value,\n  arms: List(Arm),\n) -> Result(#(List(#(String, Value)), Expr), Nil) {\n  case arms {\n    [] -> Error(Nil)\n    [#(pattern, body), ..rest] ->\n      case match_pattern(pattern, value) {\n        Ok(bindings) -> Ok(#(bindings, body))\n        Error(Nil) -> find_arm(value, rest)\n      }\n  }\n}\n\n/// The names that pattern binds if it matches value, or Error(Nil) if it doesn't.\nfn match_pattern(\n  pattern: Pattern,\n  value: Value,\n) -> Result(List(#(String, Value)), Nil) {\n  case pattern, value {\n    PBool(b1), VBool(b2) if b1 == b2 -> Ok([])\n    PInt(n1), VInt(n2) if n1 == n2 -> Ok([])\n    PWildcard, _ -> Ok([])\n    // YOUR CODE HERE\n    PVar(name), _ -> Ok([#(name, value)])\n    PList(elems, rest), VList(vs) -> match_list(elems, rest, vs)\n    _, _ -> Error(Nil)\n  }\n}\n\n/// The names that the list pattern [elems, ..rest] binds if it matches the values\n/// vs, or Error(Nil) if it doesn't.\nfn match_list(\n  elems: List(Pattern),\n  rest: Option(String),\n  vs: List(Value),\n) -> Result(List(#(String, Value)), Nil) {\n  case elems, rest, vs {\n    [], None, [] -> Ok([])\n    // YOUR CODE HERE ( replace the code below)\n    // elems is empty, but there is a rest\n    [], Some(x), _ -> {\n      Ok([#(x, VList(vs))])\n    }\n    // YOUR CODE HERE\n    [a, ..elems_rest], _, [vs_elems, ..vs_rest] ->\n      case match_pattern(a, vs_elems), match_list(elems_rest, rest, vs_rest) {\n        Ok(elem_bindings), Ok(rest_bindings) ->\n          Ok(list.append(elem_bindings, rest_bindings))\n        _, _ -> Error(Nil)\n      }\n    _, _, _ -> Error(Nil)\n  }\n}\n\n// ── Running a program ─────────────────────────────────────────────────────────\n\n/// Call the function named function in the global frame on args.\npub fn run(\n  function: String,\n  args: List(Value),\n  global: GlobalFrame,\n) -> Result(Value, EvalError) {\n  use <- limits.guarded\n  // The function's body is evaluated here rather than through apply, so that\n  // a program runs even before apply can call user-defined functions.\n  case mutable_dict.get(global, function) {\n    Ok(VFunc(UserFn(_, params, body, env))) ->\n      case list.length(params) == list.length(args) {\n        True -> eval(body, Local(dict.from_list(list.zip(params, args)), env))\n        False -> Error(MissingFunction(function, list.length(args)))\n      }\n    _ -> Error(MissingFunction(function, list.length(args)))\n  }\n}\n\n// ── Helpers ──────────────────────────────────────────────────────────────────\n\n/// The environment with the `new` bindings added to the current frame, each\n/// replacing any earlier binding of the same name in that frame. A let and a\n/// case arm bind this way.\npub fn extend(env: Env, new: List(#(String, Value))) -> Env {\n  case env {\n    Local(existing, parent) ->\n      Local(dict.merge(existing, dict.from_list(new)), parent)\n    // Global is never extended\n    Global(_) -> env\n  }\n}\n\n/// Construct a TypeError when a function is called on the wrong # of arguments.\nfn wrong_num_args(function_name: String, wanted: Int, got: Int) -> EvalError {\n  TypeError(\n    function_name\n    <> \" takes \"\n    <> int.to_string(wanted)\n    <> \" argument(s) but was given \"\n    <> int.to_string(got),\n  )\n}\n\n/// A short description for error messages that omits list or record contents.\nfn describe(v: Value) -> String {\n  case v {\n    VList(_) -> \"a list\"\n    VString(_) -> \"a string\"\n    VData(tag, _) -> \"a \" <> tag <> \" record\"\n    VFunc(f) -> \"the function \" <> f.name\n    _ -> string.inspect(v)\n  }\n}\n","new_content_size":13229,"new_hash":"1e2f031eeafd4839ce4d7f0276cddb148cd8ac07a4b7f50c792ee9c3fcce9b0b","old_hash":"97f4dec72caa2f97d0374474768a9d1a3395f9536be5ebf3f819cedfa546033b","operation":"modify","path":"src/evaluator.gleam"},"hash":"a716d6c076db23c31468b303c46d5ecbd5b5f6bb06047eaadef2096b036904a3","kind":"fs.external_change","prev_hash":"3c2f6dc1acdccf09b47fe1831d2fc95b1c8cdf81237c6aa12de90a86bc211450","seq":11015,"t":120480842,"wall":"2026-11-14T08:36:34.747Z"}
{"data":{"diff_size":9,"new_content":"//// The built-in functions of the draw mini-language: random, the type\n//// constructors, universal equality, the integer operators/comparisons, the\n//// boolean operators, and a curated subset of gleam/list.\n////\n//// global_frame() produces a global frame that binds the built-ins, to which\n//// parser.parse_program adds a program's functions. The split runs one direction —\n//// this module builds on the evaluator's Values and calls its apply, while\n//// the evaluator knows nothing about which built-ins exist — so the interpreter\n//// itself can be read in evaluator.gleam alone.\n\nimport errors.{type EvalError, TypeError}\nimport evaluator.{\n  type Bindings, type GlobalFrame, type Value, Builtin, VBool, VData, VFunc,\n  VInt, VList, VString, apply,\n}\nimport gleam/dict\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport limits\nimport mutable_dict\n\n/// A new global frame that binds the built-ins, ready for\n/// parser.parse_program to add a program's functions.\npub fn global_frame() -> GlobalFrame {\n  let frame = mutable_dict.new()\n  let bind = fn(name, value) { mutable_dict.insert(frame, name, value) }\n  dict.each(builtins(), bind)\n  frame\n}\n\n// The built-in bindings of the global frame, shared by every draw function.\nfn builtins() -> Bindings {\n  dict.from_list([\n    builtin(\"random\", 2, builtin_random),\n    builtin(\"abs\", 1, builtin_abs),\n    builtin(\"==\", 2, builtin_eq),\n    builtin(\"!=\", 2, builtin_not_eq),\n    // The parser only calls these once it has evaluated the left side to decide\n    // that the right side is needed (see parser.convert_short_circuit).\n    bool_op(\"&&\", fn(x, y) { x && y }),\n    bool_op(\"||\", fn(x, y) { x || y }),\n    int_op(\"+\", fn(x, y) { x + y }),\n    int_op(\"-\", fn(x, y) { x - y }),\n    int_op(\"*\", fn(x, y) { x * y }),\n    // Gleam's integer division truncates toward zero and yields 0 when\n    // dividing by zero, so arithmetic can never crash the interpreter.\n    int_op(\"/\", fn(x, y) { x / y }),\n    // Likewise, % is the remainder of that division, taking the sign of x,\n    // and yields 0 when dividing by zero.\n    int_op(\"%\", fn(x, y) { x % y }),\n    int_cmp(\"<\", fn(x, y) { x < y }),\n    int_cmp(\">\", fn(x, y) { x > y }),\n    int_cmp(\"<=\", fn(x, y) { x <= y }),\n    int_cmp(\">=\", fn(x, y) { x >= y }),\n    ..list.append(constructors(), list_builtins())\n  ])\n}\n\n// Every record type's constructor, taking one argument per field. The field\n// names come from the evaluator's constructors table, which also tells\n// field access how to read them back. A constructor accepts any values, so it\n// never errors.\nfn constructors() -> List(#(String, Value)) {\n  list.map(evaluator.constructors, fn(entry: evaluator.Constructor) {\n    let #(tag, fields) = entry\n    builtin(tag, list.length(fields), fn(args) { Ok(VData(tag, args)) })\n  })\n}\n\n// An entry in the global environment: a named built-in function value.\nfn builtin(\n  name: String,\n  num_args: Int,\n  run: fn(List(Value)) -> Result(Value, EvalError),\n) -> #(String, Value) {\n  #(name, VFunc(Builtin(name, num_args, run)))\n}\n\n// ── gleam/list built-ins ────────────────────────────────────────────────────\n//\n// A curated subset of gleam/list, under its real names (list.map) and with\n// gleam/list's own argument order and semantics, so what a user learns here\n// is just Gleam. Much of the rest of gleam/list names types this language\n// does not have (tuples, Result, Order, Dict).\n//\n// Every entry has the same shape — builtin(name, num_args, run) — and every run\n// function pattern-matches its arguments, answering expects(name, \"…\") to anything\n// of the wrong type. An argument that should be a function is simply handed to\n// apply, which reports a non-function itself.\n\nfn list_builtins() -> List(#(String, Value)) {\n  [\n    builtin(\"list.map\", 2, fn(args) {\n      case args {\n        [VList(xs), f] ->\n          result.map(list.try_map(xs, fn(x) { apply(f, [x]) }), VList)\n        _ -> expects(\"list.map\", \"a list and a function\")\n      }\n    }),\n    builtin(\"list.filter\", 2, fn(args) {\n      case args {\n        [VList(xs), keep] -> {\n          use kept <- result.map(\n            list.try_fold(xs, [], fn(acc, x) {\n              case apply(keep, [x]) {\n                Ok(VBool(True)) -> Ok([x, ..acc])\n                Ok(VBool(False)) -> Ok(acc)\n                Ok(_) ->\n                  Error(TypeError(\n                    \"list.filter's function must return True or False\",\n                  ))\n                Error(e) -> Error(e)\n              }\n            }),\n          )\n          VList(list.reverse(kept))\n        }\n        _ -> expects(\"list.filter\", \"a list and a function\")\n      }\n    }),\n    builtin(\"list.append\", 2, fn(args) {\n      case args {\n        // Appending copies xs, one new cell per element (ys is shared), so\n        // charge that many steps. Counting the copy is what keeps repeated\n        // appends honest: doubling a list over and over soon asks a single\n        // append for more cells than the whole allowance, so it trips\n        // StepLimit instead of hanging or exhausting memory.\n        [VList(xs), VList(ys)] -> {\n          limits.charge(list.length(xs))\n          Ok(VList(list.append(xs, ys)))\n        }\n        _ -> expects(\"list.append\", \"two lists\")\n      }\n    }),\n    builtin(\"list.length\", 1, fn(args) {\n      case args {\n        // Counting walks the whole list, so charge that many steps.\n        [VList(xs)] -> {\n          let length = list.length(xs)\n          limits.charge(length)\n          Ok(VInt(length))\n        }\n        _ -> expects(\"list.length\", \"a list\")\n      }\n    }),\n    builtin(\"list.flatten\", 1, fn(args) {\n      case args {\n        [VList(xss)] -> {\n          use lists <- result.try(\n            list.try_map(xss, fn(xs) {\n              case xs {\n                VList(elements) -> Ok(elements)\n                _ -> expects(\"list.flatten\", \"a list\")\n              }\n            }),\n          )\n          // The concatenation can dwarf every input (many sublists, possibly\n          // shared), so charge for walking every sublist and copying every\n          // element before building it — a huge result trips StepLimit\n          // without ever being materialized.\n          let total = list.fold(lists, 0, fn(n, l) { n + list.length(l) })\n          limits.charge(list.length(lists) + total)\n          Ok(VList(list.flatten(lists)))\n        }\n        _ -> expects(\"list.flatten\", \"a list of lists\")\n      }\n    }),\n  ]\n}\n\n// The type error a built-in reports for arguments of the wrong shape.\nfn expects(name: String, what: String) -> Result(a, EvalError) {\n  Error(TypeError(name <> \" expects \" <> what))\n}\n\n// ── The rest of the built-ins ─────────────────────────────────────────────────\n\nfn int_op(name: String, op: fn(Int, Int) -> Int) -> #(String, Value) {\n  builtin(name, 2, fn(args) {\n    case args {\n      [VInt(x), VInt(y)] -> Ok(VInt(op(x, y)))\n      _ -> expects(name, \"two ints\")\n    }\n  })\n}\n\nfn int_cmp(name: String, op: fn(Int, Int) -> Bool) -> #(String, Value) {\n  builtin(name, 2, fn(args) {\n    case args {\n      [VInt(x), VInt(y)] -> Ok(VBool(op(x, y)))\n      _ -> expects(name, \"two ints\")\n    }\n  })\n}\n\nfn bool_op(name: String, op: fn(Bool, Bool) -> Bool) -> #(String, Value) {\n  builtin(name, 2, fn(args) {\n    case args {\n      [VBool(x), VBool(y)] -> Ok(VBool(op(x, y)))\n      _ -> expects(name, \"two Bools\")\n    }\n  })\n}\n\n// A random integer in [min, max). If max <= min the range is empty, so we\n// just return min rather than crash.\nfn builtin_random(args: List(Value)) -> Result(Value, EvalError) {\n  case args {\n    [VInt(min), VInt(max)] ->\n      case max <= min {\n        True -> Ok(VInt(min))\n        False ->\n          Ok(VInt(\n            min + float.truncate(float.random() *. int.to_float(max - min)),\n          ))\n      }\n    _ -> expects(\"random\", \"two ints\")\n  }\n}\n\n// Absolute value of an integer.\nfn builtin_abs(args: List(Value)) -> Result(Value, EvalError) {\n  case args {\n    [VInt(n)] -> Ok(VInt(int.absolute_value(n)))\n    _ -> expects(\"abs\", \"one int\")\n  }\n}\n\n// Universal equality: any two values of the same shape. Integers compare\n// exactly (no round-off to absorb), so equality is always reliable.\nfn builtin_eq(args: List(Value)) -> Result(Value, EvalError) {\n  case args {\n    [a, b] -> result.map(value_equal(a, b), VBool)\n    _ -> expects(\"==\", \"two values\")\n  }\n}\n\n// The opposite of ==, for any two values.\nfn builtin_not_eq(args: List(Value)) -> Result(Value, EvalError) {\n  case args {\n    [a, b] -> result.map(value_equal(a, b), fn(equal) { VBool(!equal) })\n    _ -> expects(\"!=\", \"two values\")\n  }\n}\n\n// Comparison walks both structures, so each pair of nodes visited costs a step.\n// Shared substructure makes a value's walk far larger than any list's length:\n// nesting a pair of references k times deep yields 2^k leaves from k cheap builds,\n// so without this charge one == could hang the page.\nfn value_equal(a: Value, b: Value) -> Result(Bool, EvalError) {\n  limits.charge(1)\n  case a, b {\n    VInt(x), VInt(y) -> Ok(x == y)\n    VBool(x), VBool(y) -> Ok(x == y)\n    VList(xs), VList(ys) -> value_equal_lists(xs, ys)\n    VData(t1, xs), VData(t2, ys) ->\n      case t1 == t2 {\n        True -> value_equal_lists(xs, ys)\n        False -> Ok(False)\n      }\n    _, _ -> Ok(False)\n  }\n}\n\nfn value_equal_lists(\n  xs: List(Value),\n  ys: List(Value),\n) -> Result(Bool, EvalError) {\n  case xs, ys {\n    [], [] -> Ok(True)\n    [x, ..rx], [y, ..ry] ->\n      case value_equal(x, y) {\n        Ok(True) -> value_equal_lists(rx, ry)\n        other -> other\n      }\n    _, _ -> Ok(False)\n  }\n}\n","new_content_size":9806,"new_hash":"59fde6578bb480b73d4d3cec7c10c0ba58ae1dd767e88f2413f48904ab2dc2d4","old_hash":"ff02de15829a2b5d9dcb43a54eb475789c22d2fa037a019a1385724ea4d3b323","operation":"modify","path":"src/builtins.gleam"},"hash":"1712a5ee0ec8fd7da9609d89bd20b0c37ebaab3f2fe6f43471cec8a463b9cfc3","kind":"fs.external_change","prev_hash":"a716d6c076db23c31468b303c46d5ecbd5b5f6bb06047eaadef2096b036904a3","seq":11016,"t":120482765,"wall":"2026-11-14T08:36:36.671Z"}
